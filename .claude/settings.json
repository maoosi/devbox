{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read(/home/devbox/**)",
      "Read(/tmp/**)",
      "Glob(/home/devbox/**)",
      "Glob(/tmp/**)",
      "Grep(/home/devbox/**)",
      "Grep(/tmp/**)",
      "Write(/home/devbox/**)",
      "Write(/tmp/**)"
    ],
    "deny": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Write(/etc/**)",
      "Write(/root/**)",
      "Write(/usr/**)",
      "Write(/bin/**)",
      "Write(/sbin/**)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(passwd *)",
      "Bash(pkill *)",
      "Bash(kill -9 *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(* | bash)",
      "Bash(* | sh)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",
      "Bash(chmod * /etc/*)",
      "Bash(chown * /etc/*)",
      "Bash(crontab *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "ask": [
      "Bash(chmod 777 *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(npm publish *)",
      "Bash(eval *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyWrite": ["/etc", "/root", "/usr", "/bin", "/sbin", "/lib", "/lib64", "/boot"],
      "denyRead": ["/etc", "/root", "/proc", "/sys", "/var", "/run", "/boot", "/srv", "/opt", "/snap", "/mnt", "/media", "/lost+found", "/usr", "/bin", "/sbin", "/lib", "/lib64", "/dev"]
    },
    "network": {
      "allowLocalBinding": true
    }
  },
  "skipDangerousModePermissionPrompt": true
}