{
  "name": "devbox-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages/core/tests packages/ubuntu/tests/unit packages/upstash/tests",
    "test:smoke:ubuntu": "packages/ubuntu/tests/smoke/run.sh",
    "test:smoke:upstash": "bun packages/upstash/test/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3",
    "vite-plus": "0.2.2"
  }
}
