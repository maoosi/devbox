{
  "name": "@devbox/ubuntu",
  "version": "0.0.11",
  "private": true,
  "description": "Per-project devbox for running AI agents safely on any Ubuntu machine.",
  "bin": {
    "devbox": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "bun src/cli.ts",
    "test": "bun test",
    "test:smoke": "tests/smoke/run-scenario.sh s1-minimal",
    "test:smoke:one": "tests/smoke/run-scenario.sh",
    "test:smoke:full": "tests/smoke/run.sh"
  },
  "dependencies": {
    "@clack/prompts": "1.3.0",
    "@devbox/core": "workspace:*"
  }
}
